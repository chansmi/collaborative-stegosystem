# Environment Configuration Template
# Copy this file to .env and fill in your actual API keys

# Required: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Required: HuggingFace Token (for model downloads)
HF_TOKEN=your_huggingface_token_here

# Required: Weights & Biases API Key (for experiment tracking)
WANDB_API_KEY=your_wandb_api_key_here

# Test-specific settings
TEST_MODE=true
DEBUG_LEVEL=INFO
LOG_LEVEL=DEBUG

# Example API key format (replace with your actual key):
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
